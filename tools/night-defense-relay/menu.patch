+// ChalkBored: server choice, connection mode and network games. The page (ndnet.js) sets the nd_* cvars
+// and reads the "ndnet ..." lines these print to the console.
+string() Menu_Coop_ModeName =
+{
+	string m = cvar_string("nd_mode");
+	if (m == "direct") return "Direct only";
+	if (m == "relay") return "Relay only";
+	return "Auto";
+};
+
+void() Menu_Coop_NextMode =
+{
+	string m = cvar_string("nd_mode");
+	if (m == "direct") m = "relay";
+	else if (m == "relay") m = "auto";
+	else m = "direct";
+	cvar_set("nd_mode", m);
+	localcmd(sprintf("echo ndnet mode %s\n", m));
+};
+
+void(string which) Menu_Coop_PickServer =
+{
+	cvar_set("nd_server", which);
+	if (which == "builtin")
+		cvar_set("net_ice_broker", "tls://master.frag-net.com:27950");
+	else
+		cvar_set("net_ice_broker", cvar_string("nd_broker"));
+	localcmd(sprintf("echo ndnet server %s\n", which));
+	current_menu = MENU_COOP;
+};
+
+void() Menu_Coop_Server =
+{
+	Menu_DrawBackground();
+	Menu_DrawTitle("CHOOSE SERVER");
+
+	Menu_Button(1, "csm_chalkbored", "CHALKBORED SERVER", "Made for ChalkBored. Works on school Wi-Fi.") ? Menu_Coop_PickServer("chalkbored") : 0;
+	Menu_DrawOptionValue(1, "Works at school (recommended)");
+	Menu_Button(2, "csm_builtin", "BUILT-IN SERVER", "The game's own public servers. Often blocked at school.") ? Menu_Coop_PickServer("builtin") : 0;
+	Menu_DrawOptionValue(2, "Public server list, may be blocked");
+
+	Menu_Button(-1, "csm_back", "BACK", "Return to Main Menu.") ? current_menu = MENU_MAIN : 0;
+
+	sui_pop_frame();
+};
+
+float menu_coop_lan_refresh;
+
+void() Menu_Coop_EnterLan =
+{
+	localcmd("echo ndnet lan\n");
+	menu_coop_lan_refresh = time + 5;
+	current_menu = MENU_COOPLAN;
+};
+
+void() Menu_Coop_Lan =
+{
+	if (time > menu_coop_lan_refresh)
+	{
+		localcmd("echo ndnet lan\n");
+		menu_coop_lan_refresh = time + 5;
+	}
+
+	Menu_DrawBackground();
+	Menu_DrawTitle("NETWORK GAMES");
+
+	// nd_lan: "CODE~label|CODE~label|..." (set by the page, at most 6)
+	float n = 0;
+	string list = cvar_string("nd_lan");
+	if (list != "")
+		n = tokenizebyseparator(list, "|");
+	if (n > 6)
+		n = 6;
+	for (float i = 0; i < n; i++)
+	{
+		string entry = argv(i);
+		float sep = strstrofs(entry, "~");
+		string code = substring(entry, 0, sep);
+		Menu_Button(1 + i, sprintf("clm_%d", i), code, "Join this game.") ? Menu_Coop_Connect(code) : 0;
+		Menu_DrawOptionValue(1 + i, substring(entry, sep + 1, -1));
+	}
+	if (n == 0)
+		Menu_DrawOptionValue(1, cvar_string("nd_lanstatus"));
+
+	Menu_Button(-2, "clm_refresh", "REFRESH", "Look for games again.") ? Menu_Coop_EnterLan() : 0;
+	Menu_Button(-1, "clm_back", "BACK", "Return to Join Game Menu.") ? current_menu = MENU_COOPJOIN : 0;
+
+	sui_pop_frame();
+};
+
