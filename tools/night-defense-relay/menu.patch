+	else
+		Menu_Button(1, "cjm_browse", "NETWORK GAMES", "Games hosted on your network (same school or home Wi-Fi).") ? Menu_Coop_EnterLan() : 0;
+	Menu_Button(2, "cjm_direct", "ENTER ROOM CODE", "Join a friend's game with its room code.") ? current_menu = MENU_COOPDIRECT : 0;
 
 	Menu_Button(-1, "cjm_back", "BACK", "Return to Co-Op Menu.") ? current_menu = MENU_COOP : 0;
 
